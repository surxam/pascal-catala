---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { client, services } from "../data/client";

const { contact } = client;
const waLink = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(contact.messageWhatsapp)}`;
const telLink = `tel:${contact.telephone.replace(/\s/g, "")}`;
const mailLink = `mailto:${contact.email}`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contact.adresse)}`;
---

<Layout>
  <header class="fixed top-0 inset-x-0 z-50 bg-white/95 border-b border-slate-200">
    <nav class="max-w-5xl mx-auto flex items-center justify-between px-5 py-2" aria-label="Navigation principale">
      <a href="#accueil" class="text-lg font-bold min-h-[44px] inline-flex items-center">{client.nom}</a>
      <a href={telLink} class="btn gap-2 bg-azur text-white hover:bg-nuit !py-2 !px-5 text-sm">
        <Icon name="phone" class="w-5 h-5" />Appeler
      </a>
    </nav>
  </header>

  <main id="contenu">
    <!-- 1. ACCUEIL -->
    <section id="accueil" class="on-dark relative overflow-hidden bg-gradient-to-br from-nuit to-slate-800 text-white px-5 pt-32 pb-24">
      <div class="absolute -right-10 top-24 text-ciel/15 hidden md:block" aria-hidden="true">
        <Icon name="tower" class="w-96 h-96" />
      </div>
      <div class="relative max-w-5xl mx-auto">
        <p class="hero-item inline-flex items-center gap-2 text-sm uppercase tracking-[0.2em] text-ciel font-semibold">
          <Icon name="pin" class="w-4 h-4" />Fort-de-France · Martinique
        </p>
        <h1 class="hero-item text-5xl sm:text-7xl font-extrabold mt-4 leading-[1.05]">{client.nom}</h1>
        <p class="hero-item mt-4 text-xl sm:text-2xl font-medium text-ciel">{client.metier}</p>
        <p class="hero-item mt-6 text-lg text-slate-200 max-w-xl text-balance">{client.accroche}</p>

        <div class="hero-item mt-10 flex flex-col sm:flex-row gap-3">
          <a href={telLink} class="btn gap-2 bg-ciel text-nuit font-semibold hover:bg-white">
            <Icon name="phone" class="w-5 h-5" />Appeler maintenant
          </a>
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn gap-2 bg-emerald-700 text-white hover:bg-emerald-600">
            <Icon name="whatsapp" class="w-5 h-5" />WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- 2. SERVICES -->
    <section id="services" class="px-5 py-20 bg-brume">
      <div class="max-w-5xl mx-auto">
        <h2 class="reveal text-3xl sm:text-4xl font-bold text-center">Mes services</h2>
        <p class="reveal mt-3 text-center text-slate-600">Réseaux et télécoms, de l'installation au dépannage.</p>
        <ul class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {services.map((s) => (
            <li class="reveal">
              <article class="h-full rounded-3xl bg-white p-7 border border-slate-200">
                <span class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-azur text-white">
                  <Icon name={s.icon} class="w-7 h-7" />
                </span>
                <h3 class="text-xl font-semibold mt-5">{s.titre}</h3>
                <p class="mt-2 text-slate-600 text-sm">{s.texte}</p>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 3. CONTACT -->
    <section id="contact" class="px-5 py-20">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="reveal text-3xl sm:text-4xl font-bold">Contactez-moi</h2>
        <p class="reveal mt-3 text-slate-600">Une panne, un projet d'installation ? Parlons-en.</p>

        <ul class="reveal mt-10 space-y-3 text-left max-w-md mx-auto">
          <li><a href={telLink} class="flex items-center gap-4 rounded-2xl border border-slate-200 p-4 hover:border-azur transition-colors"><Icon name="phone" class="w-6 h-6 text-azur shrink-0" />{contact.telephone}</a></li>
          <li><a href={mailLink} class="flex items-center gap-4 rounded-2xl border border-slate-200 p-4 hover:border-azur transition-colors break-all"><Icon name="mail" class="w-6 h-6 text-azur shrink-0" />{contact.email}</a></li>
          <li class="flex items-start gap-4 rounded-2xl border border-slate-200 p-4"><Icon name="pin" class="w-6 h-6 text-azur shrink-0 mt-0.5" />{contact.adresse}</li>
        </ul>

        <div class="reveal mt-8 flex flex-col sm:flex-row gap-3 justify-center">
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn gap-2 bg-emerald-700 text-white hover:bg-emerald-800">
            <Icon name="whatsapp" class="w-5 h-5" />Écrire sur WhatsApp
          </a>
          <a href={mapLink} target="_blank" rel="noopener noreferrer" class="btn gap-2 border-2 border-nuit hover:bg-nuit hover:text-white">
            <Icon name="route" class="w-5 h-5" />Itinéraire
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="on-dark bg-nuit text-slate-300 text-center text-sm py-6 px-5 pb-24 sm:pb-6">
    © {new Date().getFullYear()} {client.nom} — {client.metier}
  </footer>

  <a href={telLink} aria-label="Appeler Pascal Catala" class="sm:hidden fixed z-50 right-4 bottom-4 w-14 h-14 rounded-full bg-azur text-white shadow-xl flex items-center justify-center">
    <Icon name="phone" class="w-7 h-7" />
  </a>

  <script>
    import "../scripts/animations.js";
  </script>
</Layout>
