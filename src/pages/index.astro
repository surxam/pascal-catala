---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { client, services } from "../data/client";

const { contact } = client;
const waLink = `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(contact.messageWhatsapp)}`;
const telLink = `tel:${contact.telephone.replace(/\s/g, "")}`;
const mailLink = `mailto:${contact.email}`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(contact.adresse)}`;

// Schéma réseau du hero : positions en % du carré, Pascal au centre
const noeuds = [
  { icon: "wifi", x: 50, y: 15 },
  { icon: "tower", x: 83.3, y: 39.2 },
  { icon: "server", x: 70.6, y: 78.3 },
  { icon: "phone", x: 29.4, y: 78.3 },
  { icon: "network", x: 16.7, y: 39.2 },
];
---

<Layout>
  <header class="on-dark fixed top-0 inset-x-0 z-50 bg-encre/90 backdrop-blur border-b border-white/10 text-white">
    <nav class="max-w-6xl mx-auto flex items-center justify-between px-5 py-2" aria-label="Navigation principale">
      <a href="#accueil" class="font-display font-bold text-lg min-h-[48px] inline-flex items-center">{client.nom}</a>
      <a href={telLink} class="btn bg-ambre text-encre hover:bg-white !py-2 !px-5 text-base">
        <Icon name="phone" class="w-5 h-5" />Appeler
      </a>
    </nav>
  </header>

  <main id="contenu">
    <!-- 1. PRÉSENTATION -->
    <section id="accueil" class="on-dark relative overflow-hidden bg-encre text-white px-5 pt-28 pb-20 md:pt-36 md:pb-28 bg-[radial-gradient(circle_at_85%_15%,rgba(31,79,216,0.35),transparent_55%)]">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-x-14 gap-y-10 lg:gap-y-0 items-center">
        <div class="lg:col-start-1 lg:row-start-1 lg:self-end">
          <p class="txt hero-item inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm">
            <Icon name="pin" class="w-4 h-4 text-ambre" />Fort-de-France, Martinique
          </p>
          <h1 class="txt hero-item font-display font-extrabold text-5xl sm:text-7xl leading-[1] mt-6">{client.nom}</h1>
          <p class="txt hero-item mt-4 font-display text-2xl sm:text-3xl font-semibold text-ambre">{client.metier}</p>
          <p class="txt hero-item mt-6 text-lg text-slate-200 max-w-[48ch]">{client.presentation}</p>
        </div>

        <!-- Visuel : photo sur ordinateur, schéma réseau sur mobile/tablette -->
        <div class="lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-center">
        {client.heroImage && (
          <img src={client.heroImage} alt={client.heroImageAlt} width="1200" height="800" fetchpriority="high" class="hidden lg:block mx-auto w-full max-w-[560px] aspect-[3/2] object-cover rounded-[2rem] border border-white/15 shadow-2xl" />
        )}
        <!-- Schéma affiché quand aucune photo n'est définie -->
        <div class:list={["relative mx-auto w-full max-w-[420px] aspect-square", client.heroImage && "lg:hidden"]} aria-hidden="true">
          <svg class="absolute inset-0 w-full h-full" viewBox="0 0 400 400" focusable="false">
            {noeuds.map((n) => (
              <line class="link" x1="200" y1="200" x2={n.x * 4} y2={n.y * 4} stroke="#ffb020" stroke-opacity="0.6" stroke-width="2.5" stroke-linecap="round" />
            ))}
          </svg>
          {noeuds.map((n) => (
            <div class="absolute -translate-x-1/2 -translate-y-1/2" style={`left:${n.x}%;top:${n.y}%`}>
              <div class="node hero-item w-16 h-16 rounded-full bg-encre border-2 border-white/30 flex items-center justify-center text-ambre">
                <Icon name={n.icon} class="w-7 h-7" />
              </div>
            </div>
          ))}
          <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
            <div class="hub hero-item w-24 h-24 rounded-full bg-ambre text-encre flex items-center justify-center font-display font-extrabold text-3xl">AZ</div>
          </div>
        </div>
        </div>

        <!-- Boutons d'action : après le schéma sur mobile, sous le texte sur ordinateur -->
        <div class="txt hero-item flex flex-col sm:flex-row gap-3 lg:col-start-1 lg:row-start-2 lg:self-start lg:mt-9">
          <a href={telLink} class="btn bg-ambre text-encre hover:bg-white"><Icon name="phone" class="w-5 h-5" />Appeler</a>
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn bg-voyant text-white hover:bg-emerald-600"><Icon name="whatsapp" class="w-5 h-5" />WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- 2. SERVICES -->
    <section id="services" class="bg-rack px-5 py-20 md:py-28">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-center">Mes services</h2>
        <p class="mt-3 text-center text-encre/80">Du câblage au dépannage, tout ce qu'il faut pour que ça fonctionne.</p>

        <ul class="mt-12 grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6">
          {services.map((s) => (
            <li>
              <article class="h-full rounded-3xl bg-white p-4 sm:p-7 border border-encre/10">
                <span class="inline-flex items-center justify-center w-12 h-12 sm:w-16 sm:h-16 rounded-full bg-cable text-white">
                  <Icon name={s.icon} class="w-6 h-6 sm:w-8 sm:h-8" />
                </span>
                <h3 class="font-display text-lg sm:text-2xl font-bold mt-4 sm:mt-5 leading-tight">{s.titre}</h3>
                <p class="mt-2 text-sm sm:text-base text-encre/80">{s.texte}</p>
                <ul class="mt-4 sm:mt-5 flex flex-wrap gap-1.5 sm:gap-2">
                  {s.items.map((i) => (
                    <li class="inline-flex items-center gap-1.5 rounded-full bg-rack border border-encre/10 px-2.5 sm:px-3.5 py-1 sm:py-1.5 text-xs sm:text-sm font-medium">
                      <Icon name="check" class="w-4 h-4 text-cable shrink-0" />{i}
                    </li>
                  ))}
                </ul>
              </article>
            </li>
          ))}
        </ul>

        <div class="mt-12 flex justify-center">
          <a href={telLink} class="btn bg-encre text-white hover:bg-cable"><Icon name="phone" class="w-5 h-5" />Demander un devis par téléphone</a>
        </div>
      </div>
    </section>

    <!-- 3. CONTACT -->
    <section id="contact" class="on-dark bg-encre text-white px-5 py-20 md:py-28">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-display text-4xl sm:text-5xl font-bold max-w-[20ch]">Un problème de réseau ? Appelez-moi.</h2>
        <a href={telLink} class="mt-8 inline-block font-display font-extrabold text-[clamp(2.25rem,8vw,5.5rem)] leading-none hover:text-ambre transition-colors">{contact.telephone}</a>

        <ul class="mt-10 space-y-3 text-slate-200">
          <li><a href={mailLink} class="inline-flex items-center gap-3 min-h-[48px] break-all hover:text-ambre transition-colors"><Icon name="mail" class="w-5 h-5 text-ambre shrink-0" />{contact.email}</a></li>
          <li class="flex items-start gap-3"><Icon name="pin" class="w-5 h-5 text-ambre shrink-0 mt-1" />{contact.adresse}</li>
        </ul>

        <div class="mt-10 flex flex-col sm:flex-row gap-3">
          <a href={telLink} class="btn bg-ambre text-encre hover:bg-white"><Icon name="phone" class="w-5 h-5" />Appeler</a>
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn bg-voyant text-white hover:bg-emerald-600"><Icon name="whatsapp" class="w-5 h-5" />WhatsApp</a>
          <a href={mapLink} target="_blank" rel="noopener noreferrer" class="btn border-2 border-white/60 hover:bg-white hover:text-encre"><Icon name="route" class="w-5 h-5" />Itinéraire</a>
        </div>

        <div class="mt-14 overflow-hidden rounded-3xl border border-white/15 aspect-[4/3] sm:aspect-[16/7]">
          <iframe
            title={`Carte Google Maps : ${contact.adresse}`}
            src={`https://www.google.com/maps?q=${encodeURIComponent(contact.adresse)}&output=embed`}
            class="w-full h-full"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>
  </main>

  <footer class="on-dark bg-encre text-slate-300 text-sm px-5 py-6 pb-24 sm:pb-6 border-t border-white/10">
    <div class="max-w-6xl mx-auto">© {new Date().getFullYear()} {client.nom} — {client.metier}</div>
  </footer>

  <a href={telLink} aria-label={`Appeler ${client.nom}`} class="sm:hidden fixed z-50 right-4 bottom-4 w-14 h-14 rounded-full bg-ambre text-encre shadow-xl flex items-center justify-center">
    <Icon name="phone" class="w-7 h-7" />
  </a>

  <script>
    import "../scripts/animations.js";
  </script>
</Layout>
