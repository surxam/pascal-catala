---
import "../styles/global.css";
import { client } from "../data/client";

interface Props { title?: string; description?: string }
const {
  title = `${client.nom} — ${client.metier} à Fort-de-France`,
  description = `${client.nom}, ${client.metier}, Martinique. ${client.accroche}`,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1f3a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="antialiased overflow-x-hidden">
    <a href="#contenu" class="skip-link">Aller au contenu</a>
    <slot />
  </body>
</html>
